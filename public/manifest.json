{
  "manifest_version": 3,
  "name": "QA Cat Recorder",
  "version": "0.3.2",
  "description": "Privacy-first QA recorder: steps, safe test data, screenshots, Network/Console evidence and QA drafts.",
  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "QA Cat Recorder",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "scripts/pageBridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "scripts/fieldPrivacy.js",
        "scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
