{
  "manifest_version": 3,
  "name": "QA Buddy Recorder",
  "version": "0.2.0",
  "description": "Record manual QA steps, technical errors and visual evidence.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "webRequest",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "QA Buddy Recorder",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/pageBridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "run_at": "document_start"
    }
  ]
}
